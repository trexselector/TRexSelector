# Debug symbols: R compiles with -g on every platform, and on ELF platforms
# the DWARF of the Eigen-templated translation units is linked INTO the shared
# object and dominates its size (macOS keeps it in the object files). Strip it
# after linking - the CRAN-accepted idiom (rstan, prophet, ...); no compiler
# flag is overridden. A no-op where strip or uname is absent.
all: $(SHLIB) strippedLib

strippedLib: $(SHLIB)
	if test -e "/usr/bin/strip" && test -e "/bin/uname" && [ "`/bin/uname`" = "Linux" ]; then \
	  /usr/bin/strip --strip-debug $(SHLIB); fi

.PHONY: strippedLib
